+        <info>
+        Contains possible verbs for embedded objects.
+      </info>
+      </set>
+      <group oor:name="MimeTypeClassIDRelations" oor:extensible="true">
+        <info>
+        Contains conversion table from MimeType to ClassID. MimeType is used as a name for entry.
