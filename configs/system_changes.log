+
+# Author: Pavel Mihadyuk
+# Regex fixes: Serg G. Brester
diff --git a/fail2ban/filter.d/portsentry.conf b/fail2ban/filter.d/portsentry.conf
new file mode 100644
index 0000000..35ca2a3
--- /dev/null
