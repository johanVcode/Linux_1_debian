+#model "UT16B"
+
+##############################################################################
+# Autodetect Plustek OpticPro S12 and Nortek MyScan1200
+usb 0x07b3 0x040b
+#vendor "Nortek"
+#model "MyScan 1200"
+
+##############################################################################
+# Autodetect Plustek OpticPro S24
+usb 0x07b3 0x040e
+
+##############################################################################
+# Autodetect Plustek OpticSlim M12 and NeatReceipts Scanalizer Professional 2.5
+usb 0x07b3 0x0412
+#vendor "NeatReceipts"
+#model "Scanalizer Professional 2.5"
+
