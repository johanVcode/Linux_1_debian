+        <prop oor:name="postalcode" oor:type="xs:string" oor:nillable="false">
+          <info>
+          Specifies the user's ZIP-code.
+        </info>
+          <value/>
+        </prop>
+        <prop oor:name="c" oor:type="xs:string" oor:nillable="false">
+          <info>
