+# Values:  TEXT
+#
+ignoreregex =
diff --git a/fail2ban/filter.d/mssql-auth.conf b/fail2ban/filter.d/mssql-auth.conf
new file mode 100644
index 0000000..65bbd91
--- /dev/null
+++ b/fail2ban/filter.d/mssql-auth.conf
