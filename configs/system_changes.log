+    <component>
+      <set oor:name="HandlerSet" oor:node-type="Handler">
+        <info>
+        Lists the registered protocol handler services.
+      </info>
+      </set>
+    </component>
+  </oor:component-schema>
+  <oor:component-schema oor:name="Recovery" oor:package="org.openoffice.Office" xml:lang="en-US">
+    <info/>
