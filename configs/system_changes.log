+  /usr/lib/xorg/modules/fonts/**.so*    mr,
+
+  /usr/share/fonts/{,**}                r,
+  /usr/share/fonts-*/{,**}              r,
+
+  /etc/fonts/**                         r,
+  # Debian, openSUSE paths are different
+  /usr/share/{fontconfig,fonts-config,*-fonts}/conf.avail/{,**} r,
+  /usr/share/ghostscript/fonts/{,**}    r,
+
+  /opt/kde3/share/fonts/**              r,
