+          <info>
+          Specifies the city where the user lives.
+        </info>
+          <value/>
+        </prop>
+        <prop oor:name="st" oor:type="xs:string" oor:nillable="false">
+          <info>
+          Specifies the state where the user lives.
+        </info>
+          <value/>
