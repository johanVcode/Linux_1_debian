diff --git a/xdg/plasma-workspace/env/env.sh b/xdg/plasma-workspace/env/env.sh
new file mode 100644
index 0000000..3aacc07
--- /dev/null
+++ b/xdg/plasma-workspace/env/env.sh
@@ -0,0 +1,7 @@
+## from http://standards.freedesktop.org/menu-spec/latest/
+
+# XDG_CONFIG_DIRS
+if [ -z "${XDG_CONFIG_DIRS}" ] ; then
+   XDG_CONFIG_DIRS=/etc/xdg:/usr/share/desktop-base/kf5-settings
+   export XDG_CONFIG_DIRS
+fi
