+          <prop oor:name="SplitVerticalByDefault" oor:type="xs:boolean" oor:nillable="false">
+            <info>
+            Specifies whether cells should be split vertically by default.
+            Split vertically by default
+          </info>
+            <value>false</value>
+          </prop>
+        </group>
+      </group>
+      <group oor:name="Insert">
+        <info>
