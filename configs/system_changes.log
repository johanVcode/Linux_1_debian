diff --git a/etckeeper/init.d/50vcs-perm b/etckeeper/init.d/50vcs-perm
new file mode 100755
index 0000000..4dd080b
--- /dev/null
+++ b/etckeeper/init.d/50vcs-perm
@@ -0,0 +1,12 @@
